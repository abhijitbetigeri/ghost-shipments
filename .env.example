
# Terse Durable Actors (actors/). Local dev default below; for a deployed project use the URL from `terse deploy` and set TERSE_API_KEY.
TERSE_ACTOR_URL=http://127.0.0.1:7100/v1/projects/local/actors
TERSE_API_KEY=

# --- apps/server (web pages + capture/say relay) ---
SERVER_PORT=8787
# Rover process reaches the server here (capture/say)
SERVER_URL=http://127.0.0.1:8787
# Timeout for each actor call made by the server (ms)
ACTOR_CALL_TIMEOUT_MS=4000
# Optional override for the generated Terse client (default: actors/generated/index.js)
# ACTORS_CLIENT_PATH=

# --- rover (apps/rover) ---
# Optional; auto-detects usbmodem/usbserial/ttyACM/ttyUSB/COMx
SERIAL_PORT=
# 1 = FakeLink (no Arduino); FAST caps fake moves at 300 ms
ROVER_FAKE=0
ROVER_FAKE_FAST=0
# Optional jpeg path used when /api/capture fails in fake mode
FAKE_FRAME=
VISION_MODEL=gpt-5.5
# Drive constants (apps/rover/calibration.json from `npm run calibrate -w apps/rover` is used when these are unset)
CM_PER_SEC=
NORMAL_SPEED=
# All arms; ARM_CM_1..ARM_CM_4 override per arm (default 80)
ARM_CM=
# Must match the firmware; only used for reply timeouts (default 6)
MS_PER_DEG_L=
MS_PER_DEG_R=
ROVER_ACTOR_ID=rover-1
ACTOR_TIMEOUT_MS=5000
# Rover also uses OPENAI_API_KEY, SUPABASE_URL, SUPABASE_SERVICE_KEY, TERSE_ACTOR_URL, RELAY_WORKSPACE_KEY, SERVER_URL

# --- agents (apps/agents) + Agent Relay (packages/shared/src/relay.ts) ---
# Leave empty once: the first run creates a workspace and prints RELAY_WORKSPACE_KEY=rk_live_... to paste here.
# Every process (rover, agents) must share the same key. Agent tokens are cached in .relay-tokens.json (gitignored).
RELAY_WORKSPACE_KEY=
# Optional: REST poll interval for the polling fallback (ms), and RELAY_DEBUG=1 to log websocket events
RELAY_POLL_MS=2500
RELAY_DEBUG=
OPENAI_API_KEY=
TEXT_MODEL=gpt-5.5
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Delay before inventory-agent tries to drive in `npm run conflict` (ms)
CONFLICT_DELAY_MS=4000
